# Supabase configuration
# Get these from your Supabase project dashboard: Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# To set up the database:
# 1. Create a Supabase project at https://supabase.com
# 2. Go to SQL Editor and run the migration file: supabase/migrations/00001_initial_schema.sql
# 3. Copy your project URL and anon key into a .env file (copy this file to .env)
# 4. Go to Storage → Create a bucket named "product-images" (public)
# 5. For admin access, create a user in Authentication → Users
